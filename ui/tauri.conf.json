{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zendo",
  "version": "0.1.0",
  "identifier": "dev.zendo.exec",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "zendo",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
